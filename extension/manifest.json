{
  "manifest_version": 3,
  "name": "MrVilsyAgent Tab Share",
  "version": "1.0.0",
  "description": "Sends the page you are looking at to your local MrVilsyAgent app, only when you click or press the shortcut.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:17653/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Share this page with MrVilsyAgent" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Share this page with MrVilsyAgent"
    }
  }
}
