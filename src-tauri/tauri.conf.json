{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MrVilsyAgent",
  "version": "0.1.0",
  "identifier": "com.mrvilsyagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MrVilsyAgent",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
